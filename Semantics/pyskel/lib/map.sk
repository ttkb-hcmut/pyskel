#ifndef MAP_SK
#define MAP_SK

#include "bool.sk"

type map<_>
val map_empty<a> : map<a>
val internal_map_elem<a> : (id, map<a>) -> internal_bool
val map_find<a> : (id, map<a>) -> a
val map_insert<a> : (id, a, map<a>) -> map<a>
val map_del<a> : (id, map<a>) -> map<a>

val map_elem<a> ((id: id), (m: map<a>)) : bool =
  let res = internal_map_elem<a> (id, m) in
  from_internal res

val map_lookup<a> ((s: id), (m: map<a>)) : maybe<a> =
  let mem = map_elem<a> (s, m) in
  match mem with
  | True ->
      let value = map_find<a> (s, m) in
      Just<a> value
  | False -> Nothing<a>
  end

(* MAP_SK *)
#endif
