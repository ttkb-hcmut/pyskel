(library
 (name pyskel)
 (libraries necroml pyre-ast ))

(rule
 (target semantics_full.sk)
 (deps semantics.sk list.sk maybe.sk map.sk heap.sk bool.sk function.sk)
 (action
  (pipe-stdout
   (run cpp -traditional-cpp semantics.sk)
   (with-stdout-to %{target} (run sed "/^#.*/d")))))

(rule
 (target semantics.ml)
 (deps semantics_full.sk)
 (action
  (run necroml -o %{target} -d %{deps})))

