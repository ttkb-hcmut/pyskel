(* Useful types *)
type list<a> = | Nil | Cons (a, list<a>)
type maybe<a> = | Nothing | Just a

(* Python ast *)
(* see https://github.com/grievejia/pyre-ast/blob/trunk/lib/concrete.ml *)

type pythonInt
type pythonString
type pythonBool = | True | False


type stmt =
  | SExpr expr
  | SAssign (id, expr)
  | SDel id

type constant =
  | CNone
  | CBool pythonBool
  | CInt pythonInt
  | CString pythonString

type id

type expr =
  | Constant constant
  | Name id

(* Python object *)
(* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.65 *)
type objN =
  | Int pythonInt
  | Bool pythonBool
  | String pythonString
  | None
  | NotImplemented
  | List list<addr>
  | Tuple list<addr>
  | Fun (id, list<id>, list<id>, stmt)
  | Method (addr, addr)
  | Class (id, list<id>, id, stmt)
  | Inst addr

type objS =
  | Locked
  | Methods (pythonString -> addr)

(* Read-only state, contains builtins *)
type r = (true: addr, false: addr, none: addr, notImplemented: addr)

type addr

val unboundLocalError : addr

(* Global state of the interpreter *)
type env
type heap
type flag =
  | Ret
  | Brk
  | Cont
  | Exn addr

val initialEnv : env
val getEnvData : (env, id) -> maybe<addr>
val envWrite : (env, id, maybe<addr>) -> env
val envDelete : (env, id) -> env

val heapAlloc : (heap, (objN, objS)) -> (addr, heap)
val heapRead : (heap, addr) -> ((objN, objS), heap)
val heapWrite : (heap, addr, (objN, objS)) -> ((), heap)

val initialHeap : heap
val initializedHeap (() : ()) : (r, heap) =
  let h = initialHeap in
  let (true, h) = heapAlloc (h, (Bool True, Locked)) in
  let (false, h) = heapAlloc (h, (Bool False, Locked)) in
  let (none, h) = heapAlloc (h, (None, Locked)) in
  let (notImplemented, h) = heapAlloc (h, (NotImplemented, Locked)) in
  ((true = true, false = false, none = none, notImplemented = notImplemented), h)


(* Evaluation Monad *)
type s := (env, heap)

type exn<a> =
  | Cur a
  | Flag flag

(* Evaluation monad :: Reader r (State s (Except exn a)))
type m<a> := r -> s -> (exn<a>, s)

val return<a> (v : a) : m<a> =
  \_:r -> \s:s -> (Cur<a> v, s)
val bind<a, b> (o : m<a>) (f : a -> m<b>) : m<b> =
  \r:r -> \s:s ->
    let (a, s') = o r s in
    match a with
    | Cur a ->
      f a r s'
    | Flag f ->
      (Flag<b> f, s')
    end

(* Useful functions, state manipulation *)
val ask : m<r> =
  \r:r -> \s:s -> (Cur<r> r, s)

val get : m<s> =
  \_:r -> \s:s -> (Cur<s> s, s)

val gets<a> (f : s -> a) : m<a> =
  \_:r -> \s:s -> let a = f s in (Cur<a> a, s)

val put (s: s) : m<()> =
  \_:r -> \_:s -> (Cur<()> (), s)

val modify (f: s -> s) : m<()> =
  \_:r -> \s:s -> let s' = f s in (Cur<()> (), s')

val setFlag<a> (f: flag) : m<a> =
  \_:r -> \s:s -> (Flag<a> f, s)

binder @ := bind

val ret (v : addr) : m<addr> = return<addr> v

(* Read and Modify state *)
val alloc (v:(objN, objS)) : m<addr> =
  let (e, h) =@ get in
  let (a, h') = heapAlloc (h, v) in
  let _ =@ put (e, h') in
  ret a

val read (a:addr) : m<(objN, objS)> =
  let (e, h) =@ get in
  let (v, h') = heapRead (h, a) in
  let _ =@ put (e, h') in
  return<(objN, objS)> v

val write (a:addr) (v:(objN, objS)) : m<()> =
  let (e, h) =@ get in
  let (_, h') = heapWrite (h, a, v) in
  put (e, h')

val readEnv (id:id) : m<addr> =
  let (e, _) =@ get in
  let r = getEnvData (e, id) in
  match r with
  | Nothing -> setFlag<addr> (Exn unboundLocalError)
  | Just a -> ret a
  end

val writeEnv (id:id) (a:addr) : m<()> =
  let (e, h) =@ get in
  let e' = envWrite (e, id, Just<addr> a) in
  put (e', h)

val deleteEnv (id:id) : m<()> =
  let (e, h) =@ get in
  let e' = envDelete (e, id) in
  put (e', h)

(* Evaluation rules *)
val eval_stmt (s:stmt) : m<()> =
  match s with
  | SExpr e ->
      let _ =@ eval_expr e
	  in return<()> ()
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.71 *)
  | SAssign (x, v) ->
    let addr =@ eval_expr v in
    writeEnv x addr
  | SDel id -> deleteEnv id
  end

val eval_expr (e:expr) : m<addr> =
  match e with
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.70 *)
  | Constant constant -> eval_constant constant
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.71 *)
  | Name id -> readEnv id
  end

val eval_constant (c:constant) : m<addr> =
  let builtins =@ ask in
  match c with
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.70 *)
  | CBool True -> ret builtins.true
  | CBool False -> ret builtins.false
  | CNone -> ret builtins.none
  | CInt n -> alloc (Int n, Locked)
  | CString s -> alloc (String s, Locked)
  end
