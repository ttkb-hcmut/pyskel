(* #include "/home/marsu/Documents/Travail/ENS/M1/Projet/pyskel/Semantics/pyskel/lib/list.sk" *)
#include "list.sk"
#include "maybe.sk"
#include "map.sk"
#include "heap.sk"
#include "bool.sk"

(* General String map *)
type id
val someId : id
val __init__ : id

val debug : () -> ()

(* Python ast *)
(* see https://github.com/grievejia/pyre-ast/blob/trunk/lib/concrete.ml *)
type pythonInt
type pythonString


type stmt =
  | SExpr expr
  | SAssign (id, expr)
  | SAttrAssign (expr, id, expr)
  | SDel id
  | SReturn expr
  | SRaise expr
  | SFunctionDef (id, list<id>, list<stmt>)
  (*         name,       args,           kwargs,       body *)
  | SClassDef (id, list<expr>, list<(id, expr)>, list<stmt>)
  | SNonlocal id
  | SGlobal id

type constant =
  | CNone
  | CBool bool
  | CInt pythonInt
  | CString pythonString

type expr =
  | Constant constant
  | Name id
  | Call (expr, list<expr>)
  | Attribute (expr, id)
  | Addr addr

(* Python object *)
(* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.65 *)
type objN =
  | Int pythonInt
  | Bool bool
  | String pythonString
  | None
  | NotImplemented
  | List list<addr>
  | Tuple list<addr>
  (* Fun (name, args, locals, body) *)
  | Fun (id, list<id>, list<id>, list<stmt>, maybe<scope_id>)
  | Method (addr, addr)
  | Class (id, list<addr>, id, map<addr>)
  | Inst addr

type objS =
  | Locked
  | Fields map<addr>

(* Read-only state, contains builtins *)
type builtins =
  ( true: addr
  , false: addr
  , none: addr
  , notImplemented: addr
  )
type r = (local_env: env, builtins: builtins)

type addr = heap_addr<(objN, objS)>

type pythonHeap = heap<(objN, objS)>
val pythonHeapAlloc : (pythonHeap, (objN, objS)) -> (addr, pythonHeap)
  = heapAlloc<(objN, objS)>
val pythonHeapRead : (pythonHeap, addr) -> ((objN, objS), heap<(objN, objS)>)
  = heapRead<(objN, objS)>
val pythonHeapWrite : (pythonHeap, addr, (objN, objS)) -> ((), pythonHeap)
  = heapWrite<(objN, objS)>

val initializedHeap (() : ()) : (r, pythonHeap) =
  let h = initialHeap<(objN, objS)> in
  let (true, h) = pythonHeapAlloc (h, (Bool True, Locked)) in
  let (false, h) = pythonHeapAlloc (h, (Bool False, Locked)) in
  let (none, h) = pythonHeapAlloc (h, (None, Locked)) in
  let (notImplemented, h) = pythonHeapAlloc (h, (NotImplemented, Locked)) in
  ((local_env = Globl, builtins = (true = true, false = false, none = none, notImplemented = notImplemented)), h)


val todoError : addr

(** Global state of the interpreter **)
type var_scope =
  | Local
  | NonLocal
  | Global

(* Scope: maps id to addresses *)
type scope_id = heap_addr<any_scope>
type any_scope = | TotalScope total_scope
                 | PartialScope partial_scope
type total_scope = (tscope_up: maybe<scope_id>, tmapping: map<addr>)
type partial_scope = (pscope_up: maybe<scope_id>, pmapping: map<maybe<addr>>)

val scope_up (a_scope: any_scope) : maybe<scope_id> =
  match a_scope with
  | PartialScope scope -> scope.pscope_up
  | TotalScope scope -> scope.tscope_up
  end

val find_global (id: id) : m<addr> =
  let s =@ get in
  let a = map_find<addr> (id, s.global_scope) in
  ret a

val find_local ((id: id), (sid: scope_id)) : m<maybe<maybe<addr>>> =
  let a_scope =@ readScope sid in
  match a_scope with
  | PartialScope scope ->
      let res = (map_lookup<maybe<addr>> (id, scope.pmapping)) in
      return<maybe<maybe<addr>>> res
  | TotalScope scope ->
      let res = (map_lookup<addr> (id, scope.tmapping)) in
      return<maybe<maybe<addr>>> (Just<maybe<addr>> res)
  end

val find_nonlocal' ((id: id), (sid: scope_id)) : m<maybe<maybe<addr>>> =
  let val_local =@ find_local (id, sid) in
  match val_local with
  | Nothing ->
    let a_scope =@ readScope sid in
    let a_scope_up = scope_up a_scope in
    match a_scope_up with
    | Nothing -> return<maybe<maybe<addr>>> Nothing<maybe<addr>>
    | Just sup -> find_nonlocal' (id, sup)
    end
  | Just value ->
    let res = Just<maybe<addr>> value in
    return<maybe<maybe<addr>>> res
  end

val find_nonlocal ((id: id), (sid: scope_id)) : m<maybe<maybe<addr>>> =
  let a_scope =@ readScope sid in
  let a_scope_up = scope_up a_scope in
  match a_scope_up with
  | Nothing -> return<maybe<maybe<addr>>> Nothing<maybe<addr>>
  | Just sup -> find_nonlocal' (id, sup)
  end

(* returns Nothing if id is not in scope *)
val write_local ((id: id), (a: addr), (sid: scope_id)) : m<()> =
  let a_scope =@ readScope sid in
  match a_scope with
  | PartialScope scope ->
    let mem = map_elem<maybe<addr>> (id, scope.pmapping) in
    match mem with
    | False -> setFlag<()> (Exn todoError)
    | True ->
        let m' = map_insert<maybe<addr>> (id, (Just<addr> a), scope.pmapping) in
        let s' = scope <- (pmapping = m') in
        writeScope (sid, PartialScope s')
    end
  | TotalScope scope ->
    let m' = map_insert<addr> (id, a, scope.tmapping) in
    let s' = scope <- (tmapping = m') in
    writeScope (sid, TotalScope s')
  end

val write_nonlocal' ((id: id), (a: addr), (sid: scope_id)) : m<()> =
  let a_scope =@ readScope sid in
  let wl = write_local (id, a, sid) in
  let action (f: flag) =
    match f with
    | Exn _ ->
      let a_scope_up = scope_up a_scope in
      match a_scope_up with
      | Nothing -> setFlag<()> (Exn todoError)
      | Just sup -> write_nonlocal' (id, a, sup)
      end
    | f -> setFlag<()> f
    end in
  catchFlag<()> (wl, action)

val write_nonlocal ((id: id), (a: addr), (sid: scope_id)) : m<()> =
  let a_scope =@ readScope sid in
  let a_scope_up = scope_up a_scope in
  match a_scope_up with
  | Nothing -> setFlag<()> (Exn todoError)
  | Just sup -> write_nonlocal' (id, a, sup)
  end

(* Env: maps id to scope_var *)
type env =
  | Globl
  | InFun (map<var_scope>, scope_id)
  | InClass (map<var_scope>, scope_id)

type global_scope = map<addr>

type flag =
  | Ret addr
  | Brk
  | Cont
  | Exn addr


type scope_heap = heap<any_scope>
val scopeHeapAlloc : (scope_heap, any_scope) -> (scope_id, scope_heap)
  = heapAlloc<any_scope>
val scopeHeapRead : (scope_heap, scope_id) -> (any_scope, scope_heap)
  = heapRead<any_scope>
val scopeHeapWrite : (scope_heap, scope_id, any_scope) -> ((), scope_heap)
  = heapWrite<any_scope>


(* Evaluation Monad *)
type s = (global_scope: global_scope, heap: pythonHeap, scope_heap: scope_heap)

type exn<a> =
  | Cur a
  | Flag flag

(* Evaluation monad :: Reader r (State s (Except exn a)) *)
type m<a> = (r, s) -> (exn<a>, s)

val return<a> (v : a) : m<a> =
  \(_, s):(r, s) -> (Cur<a> v, s)
val bind<a, b> ((o: m<a>), (f: a -> m<b>)) : m<b> =
  \(r, s):(r, s) ->
    let (a, s') = o (r, s) in
    match a with
    | Cur a ->
      let fa = f a in
      fa (r, s')
    | Flag f ->
      (Flag<b> f, s')
    end

binder @ = bind

val ret (v : addr) : m<addr> = return<addr> v

(* General monadic functions *)
val mapM<a, b> ((f: a -> m<b>), (l: list<a>)) : m<list<b>> =
  match l with
  | Nil -> return<list<b>> Nil<b>
  | Cons(h, t) ->
    let mh =@ f h in
    let mt =@ mapM<a, b> (f, t) in
    return<list<b>> (Cons<b>(mh, mt))
  end

val filterM<a> ((f: a -> m<bool>), (l: list<a>)) : m<list<a>> =
  match l with
  | Nil -> return<list<a>> Nil<a>
  | Cons(h, t) ->
    let b =@ f h in
    let t' =@ filterM<a> (f, t) in
    match b with
    | True -> let r = Cons<a>(h, t') in return<list<a>> r
    | False -> return<list<a>> t'
    end
  end

val zipWithM<a, b, c> ((f: (a, b) -> m<c>), (la: list<a>), (lb: list<b>)) : m<list<c>> =
  match (la, lb) with
  | (Nil, _) -> return<list<c>> Nil<c>
  | (_, Nil) -> return<list<c>> Nil<c>
  | (Cons(ha, ta), Cons(hb, tb)) ->
    let mh =@ f (ha, hb) in
    let mt =@ zipWithM<a, b, c> (f, ta, tb) in
    return<list<c>> (Cons<c>(mh, mt))
  end

(* Useful functions, state manipulation *)
val ask : m<r> =
  \(r, s):(r, s) -> (Cur<r> r, s)

val local<a> ((f: r -> r), (m: m<a>)) : m<a> =
  \(r, s):(r, s) ->
  let r' = f r in
  m (r', s)

val get : m<s> =
  \(_, s):(r, s) -> (Cur<s> s, s)

val gets<a> (f : s -> a) : m<a> =
  \(_, s):(r, s) -> let a = f s in (Cur<a> a, s)

val put (s: s) : m<()> =
  \(_, _):(r, s) -> (Cur<()> (), s)

val modify (f: s -> s) : m<()> =
  \(_, s):(r, s) -> let s' = f s in (Cur<()> (), s')

val setFlag<a> (f: flag) : m<a> =
  \(_, s):(r, s) -> (Flag<a> f, s)

val catchFlag<a> ((m: m<a>), (f: flag -> m<a>)) : m<a> =
  let s =@ get in
  let r =@ ask in
  let (res, s) = m (r, s) in
  put s ;@
  match res with
  | Cur x -> return<a> x
  | Flag flg -> f flg
  end

(* Read and Modify state *)
val alloc (v:(objN, objS)) : m<addr> =
  let s =@ get in
  let (a, h') = pythonHeapAlloc (s.heap, v) in
  let s' = s <- (heap = h') in
  put s' ;@
  ret a

val read (a:addr) : m<(objN, objS)> =
  let s =@ get in
  let (v, h') = pythonHeapRead (s.heap, a) in
  let s' = s <- (heap = h') in
  put s' ;@
  return<(objN, objS)> v

val write ((a:addr), (v:(objN, objS))) : m<()> =
  let s =@ get in
  let (_, h') = pythonHeapWrite (s.heap, a, v) in
  let s' = s <- (heap = h') in
  put s'

val createPartialScopeHere (mapping: map<maybe<addr>>): m<partial_scope> =
  let e =@ ask in
  let scope_up =
    match e.local_env with
    | Globl -> Nothing<scope_id>
    | InFun(_, sid) -> Just<scope_id> sid
    | InClass(_, sid) -> Just<scope_id> sid
    end in
  return<partial_scope> (pscope_up = scope_up, pmapping = mapping)

val createTotalScopeHere (mapping: map<addr>): m<total_scope> =
  let e =@ ask in
  let scope_up =
    match e.local_env with
    | Globl -> Nothing<scope_id>
    | InFun(_, sid) -> Just<scope_id> sid
    | InClass(_, sid) -> Just<scope_id> sid
    end in
  return<total_scope> (tscope_up = scope_up, tmapping = mapping)

val allocScope (v:any_scope) : m<scope_id> =
  let s =@ get in
  let (a, sh') = scopeHeapAlloc (s.scope_heap, v) in
  let s' = s <- (scope_heap = sh') in
  put s' ;@
  return<scope_id> a

val readScope (a:scope_id) : m<any_scope> =
  let s =@ get in
  let (v, sh') = scopeHeapRead (s.scope_heap, a) in
  let s' = s <- (scope_heap = sh') in
  put s' ;@
  return<any_scope> v

val writeScope ((a:scope_id), (v:any_scope)) : m<()> =
  let s =@ get in
  let (_, sh') = scopeHeapWrite (s.scope_heap, a, v) in
  let s' = s <- (scope_heap = sh') in
  put s'

val initialEnv : map<maybe<addr>> = map_empty<maybe<addr>>

val readEnv (id:id) : m<addr> =
  let r =@ ask in
  match r.local_env with
  | Globl -> (* We are in the global env, we just look for the variable in the global map *)
    find_global id
  | InFun (e, scope_id) -> (* We are evaluating a function, we refer to the local environment *)
    let scope_var = map_lookup<var_scope> (id, e) in
    match scope_var with
    | Nothing ->
        let ma =@ find_nonlocal (id, scope_id) in
        match ma with
        | Nothing -> find_global id
        | Just (Just a) -> ret a
        | Just Nothing -> setFlag<addr> (Exn todoError)
        end
    (* Look in the right scope *)
    | Just Local ->
        let (Just a) =@ find_local (id, scope_id) in
        match a with
        | Just a -> ret a
        (* LocalUndef *)
        | Nothing -> setFlag<addr> (Exn todoError)
        end
    | Just NonLocal ->
        (* TODO: need to handle exceptions here *)
        let Just (Just a) =@ find_nonlocal (id, scope_id) in
        ret a
    | Just Global -> find_global id
    end
  | InClass (e, scope_id) -> (* We are evaluating a class declaration, we refer to the local environment *)
    let scope_var = map_lookup<var_scope> (id, e) in
    match scope_var with
    | Nothing ->
        let ma =@ find_nonlocal (id, scope_id) in
        match ma with
        | Nothing -> find_global id
        | Just (Just a) -> ret a
        | Just Nothing -> setFlag<addr> (Exn todoError)
        end
    (* Cannot happen, nothing is Local in classes *)
    | Just Local ->
        let (Just a) =@ find_local (id, scope_id) in
        match a with
        | Just a -> ret a
        | Nothing -> setFlag<addr> (Exn todoError)
        end
    | Just NonLocal ->
        let Just (Just a) =@ find_nonlocal (id, scope_id) in
        ret a
    | Just Global -> find_global id
    end
  end

val writeEnv ((id: id), (a: addr)) : m<()> =
  let s =@ get in
  let r =@ ask in
  match r.local_env with
  | Globl ->
    let gs' = map_insert<addr> (id, a, s.global_scope) in
    let s' = s <- (global_scope = gs') in
    put s'
  | InFun (e, scope_id) ->
    let scope_var = map_lookup<var_scope> (id, e) in
    match scope_var with
      (* Not in scope => Error *)
    | Nothing ->
      setFlag<()> (Exn todoError)
      (* Local scope *)
    | Just Local ->
      write_local (id, a, scope_id)
    | Just NonLocal ->
      write_nonlocal (id, a, scope_id)
      (* In global scope, modify the value *)
    | Just Global ->
      let gs' = map_insert<addr> (id, a, s.global_scope) in
      let s' = s <- (global_scope = gs') in
      put s'
    end
  | InClass (e, scope_id) ->
    let scope_var = map_lookup<var_scope> (id, e) in
    match scope_var with
      (* Not in scope => add to current scope (not like InFun) *)
    | Nothing ->
      write_local (id, a, scope_id)
      (* Local scope *)
    | Just Local ->
      write_local (id, a, scope_id)
    | Just NonLocal ->
      write_nonlocal (id, a, scope_id)
      (* In global scope, modify the value *)
    | Just Global ->
      let gs' = map_insert<addr> (id, a, s.global_scope) in
      let s' = s <- (global_scope = gs') in
      put s'
    end
  end

val deleteEnv (id: id) : m<()> =
  let s =@ get in
  let e' = map_del<addr> (id, s.global_scope) in
  let s' = s <- (global_scope = e') in
  put s'

(* Semantics related functions *)
val locals (ss: list<stmt>) : list<id> =
  match ss with
  | Nil -> Nil<id>
  | Cons(SAssign(x, _), ss') ->
    let tail = locals ss' in
    Cons<id>(x, tail)
  | Cons(SFunctionDef(name, _, _), ss') ->
    let tail = locals ss' in
    Cons<id>(name, tail)
  | Cons(_, ss') -> locals ss'
  end

val nonlocals (ss: list<stmt>) : list<id> =
  match ss with
  | Nil -> Nil<id>
  | Cons(SNonlocal x, ss') ->
    let tail = nonlocals ss' in
    Cons<id>(x, tail)
  | Cons(_, ss') -> nonlocals ss'
  end

val globals (ss: list<stmt>) : list<id> =
  match ss with
  | Nil -> Nil<id>
  | Cons(SGlobal x, ss') ->
    let tail = globals ss' in
    Cons<id>(x, tail)
  | Cons(_, ss') -> nonlocals ss'
  end

val declarations' (ss: list<stmt>): m<map<addr>> =
  let sid =@ tscoped ss in
  let a_scope =@ readScope sid in
  match a_scope with
  (* Not possible *)
  | PartialScope _ -> setFlag<map<addr>> (Exn todoError)
  | TotalScope scope ->
    return<map<addr>> scope.tmapping
  end


(* Run code in a fresh total scope *)
val tscoped (body: list<stmt>): m<scope_id> =
  let empty_scope =@ createTotalScopeHere map_empty<addr> in
  let sid =@ allocScope (TotalScope empty_scope) in

  let non_locals = nonlocals body in
  let global_vars = globals body in
  let fun_env =
    let is_nonlocal ((m, s):(map<var_scope>, id)) = map_insert<var_scope> (s, NonLocal, m) in
    let is_global ((m, s):(map<var_scope>, id)) = map_insert<var_scope> (s, Global, m) in
    let m = foldl<id, map<var_scope>> (is_nonlocal, map_empty<var_scope>, non_locals) in
    foldl<id, map<var_scope>> (is_global, m, global_vars) in

  let in_scope = \r:r ->
    let local_env' = InClass (fun_env, sid) in
    r <- (local_env = local_env')
  in

  let eval_body = (eval_stmts body ;@ return<()> ()) in
  local<()> (in_scope, eval_body) ;@
  return<scope_id> sid

val eval_fun_call ((at_args: list<addr>), (a: list<id>), (loc: list<id>), (body: list<stmt>), (scope_up: maybe<scope_id>)): m<addr> =
  let r =@ ask in
  (* Eval and set the arguments *)
  let args_with_values = zip<id, addr> (a, at_args) in

  (* Set the local variables to LocalUndef *)
  (* Can s.scope change between here and the beginning of the function? *)
  let locals_undef =
    let f ((m, s):(map<maybe<addr>>, id)) = map_insert<maybe<addr>> (s, Nothing<addr>, m) in
    foldl<id, map<maybe<addr>>> (f , map_empty<maybe<addr>> , loc) in
  let locals_with_args =
    let f ((m, (s, a)):(map<maybe<addr>>, (id, addr))) = map_insert<maybe<addr>> (s, Just<addr> a, m) in
    foldl<(id, addr), map<maybe<addr>>> (f , locals_undef , args_with_values) in
  let inner_scope = (pscope_up = scope_up, pmapping = locals_with_args) in
  let inner_scope_id =@ allocScope (PartialScope inner_scope) in

  let non_locals = nonlocals body in
  let global_vars = globals body in
  let all_locals = append<id> (loc, a) in
  let fun_env =
    let is_local ((m, s):(map<var_scope>, id)) = map_insert<var_scope> (s, Local, m) in
    let is_nonlocal ((m, s):(map<var_scope>, id)) = map_insert<var_scope> (s, NonLocal, m) in
    let is_global ((m, s):(map<var_scope>, id)) = map_insert<var_scope> (s, Global, m) in
    let m = foldl<id, map<var_scope>> (is_local , map_empty<var_scope> , all_locals) in
    let m' = foldl<id, map<var_scope>> (is_nonlocal, m, non_locals) in
    foldl<id, map<var_scope>> (is_global, m', global_vars) in

  let set_locals = \r:r ->
    let local_env' = InFun (fun_env, inner_scope_id) in
    r <- (local_env = local_env')
  in

  let bodyEvaluation = (
    eval_stmts body ;@
    return<addr> r.builtins.none
  ) in

  let localBodyEval = local<addr> (set_locals, bodyEvaluation) in

  let catchReturn = \f:flag ->
    match f with
    | Ret a -> return<addr> a
    | f -> setFlag<addr> f
    end in

  catchFlag<addr> (localBodyEval, catchReturn)


val eval_stmts (ss: list<stmt>) : m<()> =
  mapM<stmt, ()> (eval_stmt, ss) ;@
  return<()> ()

(* Evaluation rules *)
val eval_stmt (s: stmt) : m<()> =
  match s with
  | SExpr e ->
      eval_expr e ;@
      return<()> ()
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.71 *)
  | SAssign (x, v) ->
    let addr =@ eval_expr v in
    writeEnv (x, addr)
  | SAttrAssign (e, attr, v) ->
    (* write to objs *)
    let at_e =@ eval_expr e in
    let (objn, objs) =@ read at_e in
    let at_v =@ eval_expr v in
    let objs' =
      match objs with
      | Locked ->
         let fields = map_insert<addr> (attr, at_v, map_empty<addr>) in
         Fields fields
      | Fields fields ->
         let new_fields = map_insert<addr> (attr, at_v, fields) in
         Fields new_fields
      end in
    write (at_e, (objn, objs'))
  | SDel id -> deleteEnv id
  (* Return, raise the ret flag *)
  | SReturn e ->
    let addr =@ eval_expr e in
    setFlag<()> (Ret addr)
  | SRaise e ->
    let err =@ eval_expr e in
    setFlag<()> (Exn err)
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.115 *)
  | SFunctionDef (name, args, body) ->
    let bodyLocals =
      let loc = locals body in
      let non_locals = nonlocals body in
      let global_vars = globals body in
      let tmp = remove<id>(eq<id>, non_locals, loc) in
      remove<id>(eq<id>, global_vars, tmp) in
    let e =@ ask in
    let scope_up =
      match e.local_env with
      | Globl -> Nothing<scope_id>
      | InFun(_, sid) -> Just<scope_id> sid
      | InClass(_, sid) -> Just<scope_id> sid
      end in
    let f = Fun(name, args, bodyLocals, body, scope_up) in
    let addr =@ alloc (f, Locked) in
	  writeEnv (name, addr)
  | SClassDef (name, args, kwargs, body) ->
    (* Declarations: récupérer les adresses associées aux *)
    (* définitions dans le tas après évaluation de body *)
    let dict =@ declarations' body in

    (* superclasses are in [args] *)
    let at_args =@ mapM<expr, addr> (eval_expr, args) in


    let c = Class(name, at_args, someId, dict) in
    let addr =@ alloc (c, Locked) in
    writeEnv (name, addr)
  | SNonlocal _ -> return<()> ()
  | SGlobal _ -> return<()> ()
  end

val eval_class_call ((at_args: list<addr>), (class: addr), (dict: map<addr>)): m<addr> =
  let inst = Inst class in
  let init_method = map_lookup<addr> (__init__, dict) in
  let self =@ alloc (inst, Fields map_empty<addr>) in

  match init_method with
  | Nothing -> return<()> ()
  | Just m ->
    let (objn, _) =@ read m in
    match objn with
    | Fun(_, a, loc, body, scope_up) ->
       let new_args = Cons<addr> (self, at_args) in
       eval_fun_call (new_args, a, loc, body, scope_up);@
       return<()> ()
    | _ -> setFlag<()> (Exn todoError)
    end
  end ;@
  ret self

val has_attribute ((at_e: addr), (attr: id)) : m<bool> =
  let (objn, objs) =@ read at_e in
  match objn with
  | Class (_, supers, _, dict) ->
    let get_builtin = map_lookup<addr> (attr, dict) in
    match get_builtin with
    | Nothing ->
      match objs with
      | Locked -> return<bool> False
      | Fields map ->
        let get_field = map_lookup<addr> (attr, map) in
        match get_field with
        | Nothing -> return<bool> False
        | Just a -> return<bool> True
        end
      end
    | Just a -> return<bool> True
    end
  | Inst c ->
    match objs with
    | Locked -> return<bool> False
    | Fields map ->
      let get_field = map_lookup<addr> (attr, map) in
      match get_field with
      | Nothing -> has_attribute (c, attr)
      | Just a -> return<bool> True
      end
    end
  | _ -> return<bool> False
end

val get_attribute ((at_e: addr), (attr: id)) : m<addr> =
  let (objn, objs) =@ read at_e in
  match objn with
  | Class (_, supers, _, dict) ->
    (* We inlined get_builtin_field here *)
    let get_builtin = map_lookup<addr> (attr, dict) in
    match get_builtin with
    | Just a -> ret a
    | Nothing ->
      (* look in super classes *)
      let has_attribute_attr = \super:addr -> has_attribute (super, attr) in
      let supers_with_attribute =@ filterM<addr> (has_attribute_attr, supers) in
      match supers_with_attribute with
      | Cons(h, _) -> get_attribute (h, attr)
      | Nil ->
        (* not in super classes, look in objs *)
        match objs with
        | Locked -> setFlag<addr> (Exn todoError)
        | Fields map ->
          let get_field = map_lookup<addr> (attr, map) in
          match get_field with
          | Nothing -> setFlag<addr> (Exn todoError)
          | Just a -> ret a
          end
        end
      end
    end
  | Inst c ->
    match objs with
    | Locked ->setFlag<addr> (Exn todoError)
    | Fields map ->
      let get_field = map_lookup<addr> (attr, map) in
      match get_field with
      | Nothing -> (
          (* Look for methods *)
          (* We inlined function.__get__ *)
          let attr =@ get_attribute (c, attr) in
		  let (objn, _) =@ read attr in
		  match objn with
		  | Fun _ ->
            let meth = Method (at_e, attr) in
            let at_meth =@ alloc (meth, Locked) in
            ret at_meth
		  | _ -> ret attr
		  end
        )
      | Just a -> ret a
      end
    end
  | _ -> setFlag<addr> (Exn todoError)
end

val eval_call ((at_c: addr), (args: list<expr>)): m<addr> =
  let (objn, _) =@ read at_c in
  match objn with
  | Fun(_, a, loc, body, scope_up) ->
     let at_args =@ mapM<expr, addr> (eval_expr, args) in
     eval_fun_call (at_args, a, loc, body, scope_up)
  | Class(_, _, _, dict) ->
     let at_args =@ mapM<expr, addr> (eval_expr, args) in
     eval_class_call (at_args, at_c, dict)
  | Method(self, fun) ->
    eval_call (fun, Cons<expr> (Addr self, args))
  | _ -> setFlag<addr> (Exn todoError)
  end

val eval_expr (e: expr): m<addr> =
  match e with
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.70 *)
  | Constant constant -> eval_constant constant
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.71 *)
  | Name id -> readEnv id
  | Addr a -> ret a
  | Attribute (e, attr) ->
     let at_e =@ eval_expr e in
     get_attribute (at_e, attr)
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.121 *)
  | Call(e_c, args) ->
    (* Eval the function *)
    let at_c =@ eval_expr e_c in
    eval_call (at_c, args)
  end

val eval_constant (c:constant) : m<addr> =
  let (builtins = builtins, local_env = _) =@ ask in
  match c with
  (* https://rmonat.fr/data/pubs/2021/thesis_monat.pdf#figure.caption.70 *)
  | CBool True -> ret builtins.true
  | CBool False -> ret builtins.false
  | CNone -> ret builtins.none
  | CInt n -> alloc (Int n, Locked)
  | CString s -> alloc (String s, Locked)
  end
